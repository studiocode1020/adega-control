// Copie este arquivo para `secrets.h` e preencha com os dados reais.
//
//     cp secrets.h.exemplo secrets.h
//
// O `secrets.h` está no .gitignore e NUNCA deve ser commitado (o repo é público).

#pragma once

// Rede WiFi da casa. Atenção: o ESP32 só enxerga 2,4 GHz — se o roteador
// tiver duas redes separadas (ex.: "Casa" e "Casa_5G"), use a de 2,4 GHz.
#define WIFI_SSID  "nome-da-rede"
#define WIFI_SENHA "senha-da-rede"

// Chave do aparelho: gere no app, em Menu > Portal RFID > "Gerar chave do
// aparelho". Ela aparece uma vez só. Sem ela o aparelho lê, mas não envia.
#define PORTAL_CHAVE "adg_..."

// Para onde mandar. Padrão: o app em produção. Para testar com `npm run dev`
// no Mac, use o IP do Mac na rede (http, sem s):
// #define PORTAL_URL "http://192.168.68.50:3000/api/portal/leituras"
